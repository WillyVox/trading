    "@tiptap/starter-kit": "^3.31.3",
    "clsx": "^2.1.1",
    "marked": "^14.1.4",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.14.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.13.0",
    "eslint": "^9.16.0",
