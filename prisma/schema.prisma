generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------
enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Article domain ----------
enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id                         String        @id @default(cuid())
  title                      String
  slug                       String        @unique
  excerpt                    String?
  content                    String        @db.Text
  status                     ArticleStatus @default(DRAFT)
  author                     String?
  reviewer                   String?
  category                   String?
  seoTitle                   String?
  seoDescription             String?
  canonicalUrl               String?
  featuredImage              String?
  affiliateDisclosureRequired Boolean      @default(false)
  noIndex                    Boolean       @default(false)
  publishedAt                DateTime?
  scheduledAt                DateTime?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  tags      ArticleTag[]
  sources   ArticleSource[]
  providers ArticleProvider[]
}

model ArticleTag {
  id        String  @id @default(cuid())
  articleId String
  tag       String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleSource {
  id        String  @id @default(cuid())
  articleId String
  label     String
  url       String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

enum ArticleProviderRelationship {
  MENTIONED
  COMPARED
  FEATURED
}

model ArticleProvider {
  id               String                       @id @default(cuid())
  articleId        String
  providerId       String
  relationshipType ArticleProviderRelationship @default(MENTIONED)
  article          Article                      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  provider         Provider                     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([articleId, providerId])
}

// ---------- Provider domain (factual only) ----------
enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  STALE
}

model Provider {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  logo              String?
  website            String?
  description        String?  @db.Text
  providerType        String?
  jurisdictions       String[]
  regulatoryInfo      String?
  supportedAssets     String[]
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  lastVerifiedAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  facts        ProviderFact[]
  fees         ProviderFee[]
  features     ProviderFeature[]
  sources      ProviderSource[]
  articles     ArticleProvider[]
  partnerships AffiliatePartnership[]
}

model ProviderFact {
  id                 String             @id @default(cuid())
  providerId         String
  label              String
  value               String
  sourceUrl           String?
  jurisdiction         String?
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  verifiedAt           DateTime?
  provider             Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderFee {
  id          String   @id @default(cuid())
  providerId  String
  label       String
  value       String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderFeature {
  id          String   @id @default(cuid())
  providerId  String
  label       String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderSource {
  id          String   @id @default(cuid())
  providerId  String
  label       String
  url         String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

// ---------- Affiliate domain (commercial only) ----------
enum AffiliatePartnerStatus {
  PROSPECT
  APPLIED
  APPROVED
  ACTIVE
  PAUSED
  REJECTED
  ENDED
}

enum CommissionType {
  CPA
  REVSHARE
  HYBRID
  NONE
}

model AffiliatePartnership {
  id         String                  @id @default(cuid())
  providerId String
  status     AffiliatePartnerStatus  @default(PROSPECT)
  provider   Provider                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  programs   AffiliateProgram[]
  createdAt  DateTime                @default(now())
}

model AffiliateProgram {
  id             String               @id @default(cuid())
  partnershipId  String
  commissionType CommissionType       @default(NONE)
  notes          String?
  partnership    AffiliatePartnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  links          AffiliateLink[]
}

model AffiliateLink {
  id          String    @id @default(cuid())
  programId   String
  partnerSlug String    @unique
  approvedUrl String
  placement   String?
  campaign    String?
  active      Boolean   @default(true)
  program     AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  clicks      AffiliateClick[]
}

model AffiliateClick {
  id         String        @id @default(cuid())
  linkId     String
  sourcePage String?
  placement  String?
  campaign   String?
  createdAt  DateTime      @default(now())
  link       AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model AffiliateConversion {
  id        String   @id @default(cuid())
  clickId   String?
  amount    Float?
  createdAt DateTime @default(now())
}
