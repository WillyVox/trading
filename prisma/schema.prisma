generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth ----------
enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Hashed with scrypt (see src/lib/auth/password.ts) — never store or log
  // the plaintext. Nullable because OAuth-only users (if wired up later)
  // won't have one.
  passwordHash  String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Article domain ----------
enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

// Content type, distinct from the free-text `category` topic field below.
// Deliberately minimal for now (see docs/IMPLEMENTATION-PLAN.md Article CMS
// Block 1) — NEWS/GUIDE is the only distinction the public routes currently
// need to isolate. Extend the enum (not a parallel field) if
// COMPARISON/PROVIDER_REVIEW/etc become real routed content types later.
enum ArticleType {
  NEWS
  GUIDE
}

model Article {
  id                         String        @id @default(cuid())
  title                      String
  slug                       String        @unique
  excerpt                    String?
  content                    String        @db.Text
  // `updatedAt` = technically modified in the database (any field, any
  // reason). `lastReviewedAt` below = an editor meaningfully re-checked the
  // financial content. Guide/News pages use `updatedAt` for dateModified;
  // do not conflate the two.
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  // No default: every article must be explicitly NEWS or GUIDE. Existing
  // rows are backfilled from `category` in the migration for this column
  // (see prisma/migrations/20260911071500_article_domain_foundation) before
  // this becomes NOT NULL.
  articleType                ArticleType
  // Editor-written "Key takeaways" bullets shown near the top of the Guide
  // template. Deliberately a plain string array, not auto-generated from
  // content — the spec calls for this to be high-value and non-generic.
  keyTakeaways               String[]      @default([])
  status                     ArticleStatus @default(DRAFT)
  author                     String?
  reviewer                   String?
  category                   String?
  seoTitle                   String?
  seoDescription             String?
  canonicalUrl               String?
  featuredImage              String?
  // Block 2 (Article CMS admin editor) — the featured image is meaningless
  // to screen-reader/assistive-tech users and to image-SEO without this.
  // Nullable/additive: existing rows simply have no alt text yet, which the
  // admin SEO checklist below surfaces as a warning rather than a hard error.
  featuredImageAlt           String?
  affiliateDisclosureRequired Boolean      @default(false)
  noIndex                    Boolean       @default(false)
  publishedAt                DateTime?
  scheduledAt                DateTime?
  // Editorial "meaningfully updated" timestamp, distinct from `updatedAt`
  // (which also changes on non-editorial edits like status or SEO tweaks).
  // Guide pages display this as "Last updated" instead of `updatedAt`.
  lastReviewedAt             DateTime?
  searchIntent               ArticleSearchIntent?

  // ---- Regional variants (see docs/IMPLEMENTATION-PLAN.md §7) ----
  // Simplest schema that satisfies the "meaningfully different content
  // only" rule: a nullable region code plus a self-relation back to the
  // global/default article. A row with region == null and no
  // canonicalArticleId IS the global/default version. A regional variant
  // sets both. Do not create a variant row unless its content genuinely
  // differs — see RelatedGuides / region-aware queries in
  // src/lib/articles/service.ts.
  region                     String?
  canonicalArticleId         String?
  canonicalArticle           Article?  @relation("RegionalVariant", fields: [canonicalArticleId], references: [id], onDelete: SetNull)
  regionalVariants           Article[] @relation("RegionalVariant")

  tags      ArticleTag[]
  sources   ArticleSource[]
  providers ArticleProvider[]
  cryptoAssets ArticleCryptoAsset[]

  // Curated related guides, editor-ordered. This is the top tier of the
  // relevance fallback chain in getRelatedGuides() — category/tag/intent
  // matching only kicks in once this list is exhausted.
  relatedFrom ArticleRelated[] @relation("RelatedFromArticle")
  relatedTo   ArticleRelated[] @relation("RelatedToArticle")

  @@index([category])
  @@index([region])
  @@index([searchIntent])
  @@index([status, articleType, publishedAt])
}

model ArticleRelated {
  id               String   @id @default(cuid())
  articleId        String
  relatedArticleId String
  position         Int      @default(0)
  createdAt        DateTime @default(now())

  article        Article @relation("RelatedFromArticle", fields: [articleId], references: [id], onDelete: Cascade)
  relatedArticle Article @relation("RelatedToArticle", fields: [relatedArticleId], references: [id], onDelete: Cascade)

  @@unique([articleId, relatedArticleId])
  @@index([articleId])
}

model ArticleTag {
  id        String  @id @default(cuid())
  articleId String
  tag       String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// Block 2 (Article CMS admin editor) — deliberately a small, article-specific
// enum rather than reusing `ProviderSourceType`: an article cites evidence
// ("we used AUSTRAC's register to confirm this"), a Provider *is* the
// regulator/official source itself. Merging the two would blur that
// distinction (see docs/IMPLEMENTATION-PLAN.md / Req2 §14, which explicitly
// warns against incorrectly merging the Article and Provider source
// concepts). Nullable on ArticleSource — see note there re: partial fit
// with the original Req.md source-type list.
enum ArticleSourceType {
  OFFICIAL_PROVIDER
  REGULATOR
  GOVERNMENT
  OFFICIAL_DOCUMENTATION
  NEWS
  RESEARCH
  OTHER
}

model ArticleSource {
  id         String             @id @default(cuid())
  articleId  String
  label      String
  url        String
  // Nullable/additive — existing rows and importer files that don't set
  // this simply have no classification yet; never required to save a
  // source. `publisher`/`accessedAt`/`notes` from the original source list
  // were deliberately left out of this pass — see the roadmap doc's Block 2
  // check note for why.
  sourceType ArticleSourceType?
  article    Article            @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

enum ArticleProviderRelationship {
  MENTIONED
  COMPARED
  FEATURED
}

// Editorial intent, drives which CTA / related-content strategy the Guide
// template uses (see docs/IMPLEMENTATION-PLAN.md Guide Phase 1).
enum ArticleSearchIntent {
  LEARN
  HOW_TO
  BEGINNER
  COMPARISON
  PROVIDER_GUIDE
  FEES
  SECURITY
  WALLET
  REGULATION
  MARKET_EDUCATION
}

model ArticleProvider {
  id               String                       @id @default(cuid())
  articleId        String
  providerId       String
  relationshipType ArticleProviderRelationship @default(MENTIONED)
  article          Article                      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  provider         Provider                     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([articleId, providerId])
}

// ---------- Provider domain (factual only) ----------
enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  STALE
}

enum ProviderSourceType {
  OFFICIAL_WEBSITE
  OFFICIAL_FEES
  OFFICIAL_TERMS
  OFFICIAL_SUPPORT
  REGULATOR
  GOVERNMENT
  APP_STORE
  THIRD_PARTY_RESEARCH
  OTHER
}

// ---------- Share trading platform domain (Offering foundation) ----------
// See docs/IMPLEMENTATION-PLAN.md and the 2026-09-17 offering-architecture
// analysis: a flattened Provider record (the crypto shape above) can't
// represent a broker whose comparable facts vary by market and product
// (CommSec's ASX brokerage is tiered and different again for international
// shares; CHESS applies to ASX holdings but not international ones at the
// same broker). ProviderOffering is the thing users actually compare;
// Provider stays the brand/legal-entity row for both domains.
//
// Deliberately excluded from Milestone 1 (see ROADMAP.md): OfferingOrderType,
// OfferingFeature. OfferingFee/OfferingFeeTier landed in Phase 2 (below) as
// its own additive migration, per the master prompt's "fees are Phase Two"
// sequencing.
// Also deliberately NOT modelled yet: a separate FinancialEntity/
// service-role layer for AFSL holder vs. executing broker vs. custodian --
// `custodianName` below is a plain string for now; that's the documented
// seam where future normalization would attach, not an oversight.
enum OfferingType {
  CRYPTO_EXCHANGE
  SHARE_TRADING
  CFD_TRADING
  FOREX_TRADING
  MANAGED_FUND
  SUPERANNUATION
  CRYPTO_WALLET
  OTHER
}


enum OfferingFeatureType {
  AUD_DEPOSITS
  AUD_WITHDRAWALS
  PAYID
  BANK_TRANSFER
  CARD_DEPOSIT
  MOBILE_APP
  WEB_PLATFORM
  LIMIT_ORDERS
  MARKET_ORDERS
  STOP_ORDERS
  RECURRING_BUYS
  STAKING
  API_ACCESS
  ADVANCED_CHARTING
  TWO_FACTOR_AUTH
  COLD_STORAGE
  SMSF_SUPPORT
  OTC_DESK
  OTHER
}

// Editorial pros/limitations shown on an offering's profile. Kept sourced
// like every other Offering fact (sourceUrl + verificationStatus) rather
// than free-floating marketing copy -- see docs/IMPLEMENTATION-PLAN.md
// cross-cutting rule against fabricated/superlative claims. `label` should
// stay a short, factual, non-superlative statement ("Wide coin selection
// (500+)", not "The best coin selection").
enum OfferingProsConsType {
  PRO
  LIMITATION
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  CONDITIONAL
  LIMITED
  UNKNOWN
}

enum InvestmentProductType {
  AU_SHARES
  INTERNATIONAL_SHARES
  ETF
  OPTIONS
  BONDS
  MANAGED_FUNDS
  FUTURES
  WARRANTS
  FOREX
  CFD
  OTHER
}

enum CustodyType {
  CHESS_SPONSORED
  ISSUER_SPONSORED
  CUSTODIAL
  DIRECT_REGISTRATION
  OMNIBUS
  MIXED
  OTHER
  UNKNOWN
}

enum AccountType {
  INDIVIDUAL
  JOINT
  COMPANY
  TRUST
  SMSF
  MINOR
  ADVISER
  PROFESSIONAL
  OTHER
}

// ---------- Offering pricing (Phase 2) ----------
// Deliberately NOT a generic rules engine (no OfferingFeeCondition /
// ConditionOperator). Checked against the real CommSec and CMC Invest AU
// schedules: the only things a fee genuinely varies by are the market
// (existing marketId FK), how the trade is placed/settled (FeeChannel), and
// the trade value (OfferingFeeTier). A generic EQUALS/BETWEEN/IN engine would
// be solving a problem this data doesn't have yet.
//
// Also deliberately deferred: OfferingPricingPlan (named plan tiers such as
// IBKR Lite vs Pro). Neither seeded broker's AU offering has named plans in
// the sense IBKR does; it gets added when IBKR is seeded, not speculatively.
// (CMC Invest's ALPHA and CommSec's International Shares Plus are noted in
// `notes` text on the affected rows for now -- the same "documented seam,
// not built yet" pattern as `custodianName` above.)
enum FeeCategory {
  BROKERAGE
  FX_CONVERSION
  ACCOUNT_KEEPING
  INACTIVITY
  WITHDRAWAL
  DEPOSIT
  EXCHANGE_TRANSFER // e.g. off-market / CHESS transfer fees
  CRYPTO_TRADING
  MAKER
  TAKER
  INSTANT_BUY
  FIAT_DEPOSIT
  FIAT_WITHDRAWAL
  CRYPTO_WITHDRAWAL
  SPREAD
  OTHER
}

enum FeeCalculationBasis {
  FLAT
  PERCENTAGE
  GREATER_OF // max(flatAmount, trade_value * percentage / 100)
  TIERED // see OfferingFeeTier rows
  FREE
  VARIES // no structured value -- displayValue + notes only
}

// A real, observed dimension (not a generic condition system): CommSec's AU
// brokerage genuinely differs by *how* you trade and settle, nothing else.
enum FeeChannel {
  ONLINE_STANDARD_SETTLEMENT // online, settling to CDIA / Margin Loan
  ONLINE_OWN_BANK_SETTLEMENT // online, settling to a bank account of your choice
  PHONE_OR_ESTATE
  THIRD_PARTY_SETTLEMENT
}

model Market {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  countryCode String?
  exchangeCode String?
  currency    String?
  region      String?
  active      Boolean  @default(true)

  offerings OfferingMarket[]
  custody   OfferingCustody[]
  fees      OfferingFee[]
}

model ProviderOffering {
  id                 String              @id @default(cuid())
  providerId         String
  name               String
  slug               String              @unique
  logo               String?
  website            String?
  description        String?             @db.Text
  offeringType       OfferingType
  jurisdiction       String?
  active             Boolean             @default(true)
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  lastVerifiedAt     DateTime?
  seoTitle           String?
  seoDescription     String?
  noIndex            Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  provider     Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  markets      OfferingMarket[]
  products     OfferingProduct[]
  custody      OfferingCustody[]
  accountTypes OfferingAccountType[]
  fees         OfferingFee[]
  features     OfferingFeature[]
  prosCons     OfferingProsCon[]
  cryptoAssets OfferingCryptoAsset[]

  @@index([providerId])
  @@index([offeringType])
  @@index([offeringType, active])
}

model OfferingFeature {
  id                 String              @id @default(cuid())
  offeringId         String
  featureType        OfferingFeatureType
  label              String?
  value              String?
  available          Boolean?
  sourceUrl          String?
  jurisdiction       String?
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  verifiedAt         DateTime?

  offering ProviderOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, featureType])
  @@index([offeringId])
  @@index([featureType])
}

model OfferingProsCon {
  id                 String               @id @default(cuid())
  offeringId         String
  type               OfferingProsConsType
  label              String
  detail             String?              @db.Text
  sourceUrl          String?
  jurisdiction       String?
  verificationStatus VerificationStatus   @default(UNVERIFIED)
  verifiedAt         DateTime?
  position           Int                  @default(0)

  offering ProviderOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@index([offeringId, type])
}

model OfferingCryptoAsset {
  offeringId String
  assetId    String

  offering ProviderOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  asset     CryptoAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([offeringId, assetId])
  @@index([assetId])
}

model OfferingMarket {
  id           String             @id @default(cuid())
  offeringId   String
  marketId     String
  availability AvailabilityStatus @default(UNKNOWN)
  notes        String?            @db.Text

  sourceUrl          String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?

  offering ProviderOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  market   Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([offeringId, marketId])
  @@index([offeringId])
  @@index([marketId])
}

model OfferingProduct {
  id           String                @id @default(cuid())
  offeringId   String
  productType  InvestmentProductType
  availability AvailabilityStatus    @default(UNKNOWN)
  notes        String?               @db.Text

  sourceUrl          String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?

  offering ProviderOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, productType])
  @@index([offeringId])
}

// Nullable `marketId` = applies offering-wide; set = a market-specific
// override (e.g. CommSec's ASX holdings are CHESS-sponsored but its
// international holdings are custodial -- see docs/IMPLEMENTATION-PLAN.md
// Section 14). Milestone 1's seed always sets marketId explicitly rather
// than relying on the offering-wide null case, since both seeded brokers
// genuinely differ by market -- the null case remains for a future,
// simpler broker where one custody arrangement really does apply everywhere.
model OfferingCustody {
  id             String      @id @default(cuid())
  offeringId     String
  marketId       String?
  custodyType    CustodyType
  hinSupported   Boolean?
  custodianName  String?
  description    String?     @db.Text

  sourceUrl          String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?

  offering ProviderOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  market   Market?          @relation(fields: [marketId], references: [id], onDelete: SetNull)

  @@index([offeringId])
  @@index([marketId])
}

model OfferingAccountType {
  id           String             @id @default(cuid())
  offeringId   String
  accountType  AccountType
  availability AvailabilityStatus @default(UNKNOWN)
  notes        String?            @db.Text

  sourceUrl          String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?

  offering ProviderOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, accountType])
  @@index([offeringId])
}

// One row = one fee (or one fee schedule, when calculationBasis is TIERED).
//
// Units: `percentage` is stored in PERCENT POINTS, not a fraction -- 0.12
// means 0.12%, 0.55 means 0.55% (Decimal(6,4) holds up to 99.9999). Kept
// that way so the value in the database reads exactly like the number on the
// broker's own fee page.
//
// `marketId`: null = offering-wide (e.g. FX conversion); set = per-market
// (e.g. AU vs US brokerage). Same convention as OfferingCustody.
//
// `channel`: null when the fee doesn't vary by channel.
//
// Promotions are a few honest fields, not a rules engine: isPromotional +
// validFrom/validTo + prose in `promotionalTerms`. A promotional row is
// always an ADDITION to the standing schedule, never a replacement for it --
// the standing schedule keeps its own non-promotional row(s), so an expired
// promo can never masquerade as the everyday price.
model OfferingFee {
  id               String              @id @default(cuid())
  offeringId       String
  marketId         String?
  feeCategory      FeeCategory
  channel          FeeChannel?
  label            String
  calculationBasis FeeCalculationBasis

  flatAmount   Decimal? @db.Decimal(10, 2)
  percentage   Decimal? @db.Decimal(6, 4)
  currency     String?
  displayValue String?
  notes        String?  @db.Text

  isPromotional    Boolean   @default(false)
  validFrom        DateTime?
  validTo          DateTime?
  promotionalTerms String?   @db.Text

  sourceUrl          String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?

  offering ProviderOffering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  market   Market?           @relation(fields: [marketId], references: [id], onDelete: SetNull)
  tiers    OfferingFeeTier[]

  @@index([offeringId])
  @@index([marketId])
  @@index([feeCategory])
}

// Bounds semantics (matches the "up to and including" wording brokers use):
//   - `maxAmount` is an INCLUSIVE upper bound; null = no upper bound.
//   - `minAmount` is the tier's lower edge. For a tier that follows an
//     inclusive max, it equals the previous tier's maxAmount and the value
//     must be strictly greater than it (CommSec: "Over $1,000 up to $3,000").
//   - Where a broker draws the boundary at the cent (CommSec bank-settled:
//     "up to and including $9,999.99" / "$10,000 and above"), the seed stores
//     exactly that: max 9999.99, next tier min 10000.
// A tier row is either a flat dollar amount OR a percentage (percent points,
// as on OfferingFee), never both.
model OfferingFeeTier {
  id         String   @id @default(cuid())
  feeId      String
  minAmount  Decimal  @db.Decimal(14, 2)
  maxAmount  Decimal? @db.Decimal(14, 2)
  flatAmount Decimal? @db.Decimal(10, 2)
  percentage Decimal? @db.Decimal(6, 4)
  position   Int      @default(0)

  fee OfferingFee @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@index([feeId])
}

model Provider {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  logo               String?
  website            String?
  description        String?             @db.Text
  jurisdictions      String[]
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  lastVerifiedAt     DateTime?
  // SEO overrides — mirrors Article's seoTitle/seoDescription/noIndex so
  // generateMetadata() can treat both domains the same way.
  seoTitle           String?
  seoDescription     String?
  noIndex            Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  facts        ProviderFact[]
  sources      ProviderSource[]
  regulations  ProviderRegulation[]
  articles     ArticleProvider[]
  partnerships AffiliatePartnership[]
  offerings    ProviderOffering[]
}

model ProviderFact {
  id                 String             @id @default(cuid())
  providerId         String
  label              String
  value              String
  sourceUrl          String?
  jurisdiction       String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  provider           Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model ProviderSource {
  id         String             @id @default(cuid())
  providerId String
  label      String
  url        String
  sourceType ProviderSourceType

  jurisdiction String?
  publishedAt  DateTime?
  checkedAt    DateTime?

  verificationStatus VerificationStatus @default(UNVERIFIED)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([sourceType])
}

model ProviderRegulation {
  id             String   @id @default(cuid())
  providerId     String
  jurisdiction   String
  regulator      String
  registrationId String?
  status         String?

  sourceUrl  String?
  verifiedAt DateTime?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([jurisdiction])
}

// ---------- Crypto asset domain ----------
model CryptoAsset {
  id          String   @id @default(cuid())
  symbol      String   @unique
  name        String
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offerings OfferingCryptoAsset[]
  articles  ArticleCryptoAsset[]
}

model ArticleCryptoAsset {
  articleId String
  assetId   String

  article Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  asset   CryptoAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([articleId, assetId])
  @@index([assetId])
}

// ---------- Affiliate domain (commercial only) ----------
enum AffiliatePartnerStatus {
  PROSPECT
  APPLIED
  APPROVED
  ACTIVE
  PAUSED
  REJECTED
  ENDED
}

enum CommissionType {
  CPA
  REVSHARE
  HYBRID
  NONE
}

model AffiliatePartnership {
  id         String                  @id @default(cuid())
  providerId String
  status     AffiliatePartnerStatus  @default(PROSPECT)
  provider   Provider                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  programs   AffiliateProgram[]
  createdAt  DateTime                @default(now())
}

model AffiliateProgram {
  id             String               @id @default(cuid())
  partnershipId  String
  commissionType CommissionType       @default(NONE)
  notes          String?
  partnership    AffiliatePartnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  links          AffiliateLink[]
}

model AffiliateLink {
  id          String    @id @default(cuid())
  programId   String
  partnerSlug String    @unique
  approvedUrl String
  placement   String?
  campaign    String?
  active      Boolean   @default(true)
  program     AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  clicks      AffiliateClick[]
}

model AffiliateClick {
  id         String        @id @default(cuid())
  linkId     String
  sourcePage String?
  placement  String?
  campaign   String?
  createdAt  DateTime      @default(now())
  link       AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model AffiliateConversion {
  id        String   @id @default(cuid())
  clickId   String?
  amount    Float?
  createdAt DateTime @default(now())
}
